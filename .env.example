# ============================================
# CONFIGURAÇÕES BÁSICAS DO DJANGO
# ============================================
# NUNCA commite o arquivo .env (apenas este .env.example sem valores reais).
# Copie: cp .env.example .env  e preencha localmente.

# Chave secreta do Django (OBRIGATÓRIA — mín. 50 caracteres, alta entropia)
# Gere: python manage.py check_security --generate-secret-key
SECRET_KEY=

# Ambiente: development | production (produção força DEBUG=False)
# DJANGO_ENV=development
# PRODUCTION=false

# Modo de debug — em produção/VPS o boot FALHA se True
DEBUG=True

# Mídia pública via Django: APENAS dev local (DEBUG=True). Proibido na VPS.
# SERVE_MEDIA_VIA_DJANGO=false

# HTTPS (produção atrás de Nginx)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# CSRF HttpOnly: True em produção (automático). Dev: opcional
# CSRF_COOKIE_HTTPONLY=False

# URLs assinadas de mídia (segundos)
# MEDIA_SIGNED_URL_MAX_AGE=3600

# VPS Hostinger (produção): defina true e configure domínio
# VPS_ENVIRONMENT=true
# SITE_DOMAIN=rmsys.app
# VPS_MEDIA_ROOT=/var/www/saas-viabilidade/media

# Hosts permitidos (separados por vírgula)
# Desenvolvimento: 127.0.0.1,localhost | Produção: rmsys.app,www.rmsys.app
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Origens confiáveis para CSRF (separadas por vírgula)
# Dev: http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173
# Produção: https://seudominio.com,https://www.seudominio.com
CSRF_TRUSTED_ORIGINS=

# ============================================
# MIGRAÇÃO REACT SPA (Fase 0+)
# ============================================
# hybrid = SSR + SPA | spa | ssr
FRONTEND_MODE=hybrid
FRONTEND_URL=http://localhost:5173
# Origens CORS para o Vite dev server (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dev celular via ngrok (opcional — cole a URL https do ngrok após subir o túnel):
# FRONTEND_URL=https://SEU-ID.ngrok-free.app
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://SEU-ID.ngrok-free.app
# CSRF_TRUSTED_ORIGINS=https://SEU-ID.ngrok-free.app
# ALLOWED_HOSTS=localhost,127.0.0.1,SEU-ID.ngrok-free.app
# Script: .\scripts\dev-tunnel.ps1  (Cloudflare — sem conta)
# Ou: .\scripts\dev-tunnel.ps1 -Provider local  (mesma Wi-Fi)
# ngrok (com conta): .\scripts\dev-tunnel.ps1 -Provider ngrok
# JWT (simplejwt)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ============================================
# CONFIGURAÇÕES DE BANCO DE DADOS
# ============================================

# String de conexão do PostgreSQL (OBRIGATÓRIA)
# Formato: postgresql://usuario:senha@host:porta/nome_banco?sslmode=require
# Exemplo para Neon: postgresql://neondb_owner:senha@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Exemplo local: postgresql://postgres:senha@localhost:5432/saas_viabilidade
DATABASE_URL=postgresql://postgres:senha123@localhost:5432/saas_viabilidade

# Tempo máximo de conexão ao banco (em segundos)
# 0 = fechar após cada requisição
# 600 = manter conexão aberta por 10 minutos (recomendado para produção)
DB_CONN_MAX_AGE=0

# Configurações alternativas de banco (usadas apenas em settings_production.py)
# Se DATABASE_URL estiver definida, estas serão ignoradas
DB_NAME=saas_viabilidade
DB_USER=postgres
DB_PASSWORD=senha123
DB_HOST=localhost
DB_PORT=5432

# ============================================
# CONFIGURAÇÕES DE CACHE (REDIS)
# ============================================

# URL do Redis (opcional, usado apenas em produção)
# Formato: redis://localhost:6379/1
# Ou: redis://:senha@host:porta/1
REDIS_URL=redis://localhost:6379/1

# ============================================
# CONFIGURAÇÕES DE EMAIL
# ============================================

# Resend (recomendado) — https://resend.com
EMAIL_BACKEND=core.email.resend_backend.ResendEmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Branding dos e-mails (logo/banner — arquivos em static/email/)
EMAIL_ICON_URL=/static/email/icon-email.png
EMAIL_LETTREIRO_URL=/static/email/letreiro-email.png
# Legado (opcional — substituído por icon + letreiro acima)
# EMAIL_LOGO_URL=/static/email/logo-email.png
# EMAIL_BANNER_URL=/static/email/banner.jpg
EMAIL_EMBED_IMAGES=true
EMAIL_BRAND_COLOR=#0891b2
EMAIL_BRAND_COLOR_DARK=#1e3a8a
# EMAIL_SUPPORT_EMAIL=suporte@rmsys.com.br

# BIMI — logo no perfil do remetente (Gmail). Guia: docs/BIMI_SETUP.md
# BIMI_LOGO_URL=https://rmsys.com.br/.well-known/bimi/logo.svg

# SMTP alternativo (legado)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-app
# DEFAULT_FROM_EMAIL=noreply@rmsys.com.br

# ============================================
# CONFIGURAÇÕES DO VERIFICADOR DE VIABILIDADE
# ============================================

# Timeout para requisições de roteamento (em segundos)
ROUTING_TIMEOUT=15

# Distâncias de viabilidade (em metros)
# Até esta distância = Viável
VIABILIDADE_VIABLE=300

# Entre VIABILIDADE_VIABLE e esta distância = Viabilidade Limitada
VIABILIDADE_LIMITADA=800

# Acima desta distância = Sem Viabilidade
VIABILIDADE_INVIAVEL=800

# Chave da API do OpenRouteService (opcional)
# Melhora a qualidade do roteamento, mas não é obrigatória
# Obtenha em: https://openrouteservice.org/
OPENROUTESERVICE_API_KEY=sua-chave-api-aqui

# ============================================
# ALERT BRIDGE (Telegram → WhatsApp, pasta MENSAGENS/)
# ============================================
# Token compartilhado entre Django e o worker Node
ALERT_BRIDGE_API_TOKEN=defina-um-token-longo-aleatorio
# IPs permitidos na API interna (vírgula). Padrão: apenas localhost
# ALERT_BRIDGE_ALLOWED_IPS=127.0.0.1,::1

# Criptografia de campos sensíveis (OLT, VPN, Telegram) — OBRIGATÓRIA em dev/prod
# Gere e grave no .env: python manage.py setup_p1_security --write-key
# Fallback via SECRET_KEY só com ALLOW_FIELD_ENCRYPTION_SECRET_FALLBACK=true (não use em produção)
FIELD_ENCRYPTION_KEY=
# ALLOW_FIELD_ENCRYPTION_SECRET_FALLBACK=false

# Versão dos documentos legais (LGPD)
LEGAL_DOCUMENT_VERSION=2026-05-21
# Retenção de caches geocoding/viabilidade (dias)
CACHE_RETENTION_DAYS=90
# Geocoding cache (LGPD — hash SHA-256, sem endereço completo no banco)
GEOCODING_CACHE_TTL_HOURS=24
# Salt dedicado (recomendado em produção; se vazio, deriva de SECRET_KEY)
GEOCODING_CACHE_SALT=
# Encarregado de dados (DPO)
DPO_EMAIL=privacidade@rmsys.com.br
# Link de ativação de conta (minutos, padrão 30)
ACCOUNT_ACTIVATION_EXPIRY_MINUTES=30
# Backup GPG: caminho para arquivo com passphrase (opcional, P3)
# BACKUP_GPG_PASSPHRASE_FILE=/var/backups/.backup_gpg_pass
# Não servir /media/ via Django em produção (use Nginx)
SERVE_MEDIA_VIA_DJANGO=false

# Superusuários RM em dev (opcional; só com DEBUG e RM_SEED_SUPERUSERS=true)
# RM_SEED_SUPERUSERS=true
# RM_SEED_USER_1_USERNAME=admin.rm
# RM_SEED_USER_1_EMAIL=admin@example.com
# RM_SEED_USER_1_PASSWORD=senha-forte-aleatoria

# Rate limit ativo mesmo em DEBUG (testes)
# FORCE_RATE_LIMIT=true

# ============================================
# FASE 2 — HARDENING (LGPD + OWASP)
# ============================================
# Hash de busca CNPJ (recomendado em produção)
CNPJ_HASH_SALT=
# CSP estrito (padrão: true). Desative só se precisar de unsafe-inline em dev: CSP_STRICT=false
CSP_STRICT=true
# Só confiar em X-Forwarded-For se REMOTE_ADDR for proxy listado (lockout, sessão, MFA)
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Legado bridge: ALERT_BRIDGE_TRUSTED_PROXIES (mesmo efeito se TRUSTED_PROXY_IPS vazio)
# TRUST_X_FORWARDED_FOR=true
# Ocultar header Server nas respostas Django (edge nginx ainda deve usar server_tokens off)
# HIDE_SERVER_HEADER=true
# Hosts extras img-src (vírgula), ex.: https://cdn.seudominio.com
# CSP_IMG_EXTRA_HOSTS=
# Métodos HTTP adicionais a bloquear (além de TRACE/CONNECT)
# DISALLOWED_HTTP_METHODS=
# Histórico de busca FTTH (sessionStorage + TTL)
FTTH_SEARCH_HISTORY_ENABLED=true
FTTH_SEARCH_HISTORY_MAX_ITEMS=8
FTTH_SEARCH_HISTORY_TTL_MINUTES=30
# MFA TOTP para RM / staff / superuser
# MFA_REQUIRED=true
# MFA_REQUIRED_COMPANY_ADMINS=false
# MFA_REMEMBER_DAYS=30
# CSP estrito (nonce + strict-dynamic; sem unsafe-inline em scripts)
# CSP_STRICT=true
# Sessões concorrentes máximas por usuário
# SESSION_MAX_CONCURRENT=3
# Redis (rate limit, lockout, MFA remember, bridge nonce)
# REDIS_URL=redis://127.0.0.1:6379/1
# USE_REDIS_CACHE=true
# DRF throttling
# DRF_THROTTLE_BURST=60/min
# DRF_THROTTLE_SUSTAINED=2000/hour
# Bridge HMAC (anti-replay; use segredo diferente do token — obrigatório em produção)
BRIDGE_HMAC_SECRET=
BRIDGE_REQUIRE_HMAC=true
BRIDGE_SIGNATURE_MAX_AGE_SEC=120
BRIDGE_NONCE_TTL_SEC=300
ALERT_BRIDGE_TRUSTED_PROXIES=127.0.0.1,::1
# BRIDGE_FETCH_TIMEOUT_MS=15000
# Rotação: python manage.py rotate_bridge_credentials

# OLT — logs sanitizados (sem senhas/IPs privados completos no banco)
OLT_LOG_MAX_CHARS=200000
OLT_LOG_RETENTION_DAYS=7

# OLT worker — container Docker com rede isolada por job (recomendado multi-tenant com VPN)
# host = thread no Gunicorn + mutex VPN global | container = docker run por job
OLT_EXECUTION_MODE=host
OLT_WORKER_IMAGE=rmsys/olt-worker:latest
OLT_DOCKER_BINARY=docker
OLT_MAX_PARALLEL_JOBS=5
OLT_CONTAINER_JOB_TIMEOUT=3600
# Args extras: ex. --network=host se PostgreSQL estiver no host Linux
# OLT_DOCKER_RUN_ARGS=--network=host
# Cron: python manage.py purge_olt_logs --days=7

# Logging enterprise
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# REDIS_URL=redis://localhost:6379/1

# ============================================
# FASE 3 — LIMPEZA + HARDENING AVANÇADO
# ============================================
# Sessão
SESSION_COOKIE_AGE=3600
SESSION_IDLE_TIMEOUT=1800
# Retenção LGPD (dias)
AUDIT_RETENTION_DAYS=365
ACTIVATION_TOKEN_RETENTION_DAYS=7
CONSENT_RETENTION_DAYS=1825
DSR_RETENTION_DAYS=1825
TICKET_RETENTION_DAYS=730
DSR_PENDING_MAX_DAYS=30
DSR_MAX_RETRIES=3
LGPD_EXPORT_TTL_HOURS=24
LGPD_EXPORT_MAX_DOWNLOADS=5
# Uploads
# UPLOAD_ANTIVIRUS_ENABLED=true
# CLAMSCAN_PATH=clamscan
# UPLOAD_QUARANTINE_DIR=/var/www/saas-viabilidade/media/quarantine
# Validação estrita de .env em produção
ENV_VALIDATION_STRICT=true
# URL da API (opcional — o runserver preenche automaticamente)
# ALERT_BRIDGE_API_URL=http://127.0.0.1:8000/api/internal/alert-bridge/configs/
# Sobe o worker junto com: python manage.py runserver (apenas DEBUG=true)
RUN_ALERT_BRIDGE=true
# API interna WhatsApp (QR / pareamento no painel SaaS)
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3921
WHATSAPP_BRIDGE_PORT=3921
# WhatsApp (login do worker — também pode ficar em MENSAGENS/.env)
# WHATSAPP_LOGIN_MODE=qr
# WHATSAPP_PAIRING_PHONE=5521999999999

# ============================================
# CONFIGURAÇÕES DE MONITORAMENTO
# ============================================

# DSN do Sentry (Error Monitoring — sem PII; ver saas_viabilidade/sentry_bootstrap.py)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0