# Modo legado (npm start). No SaaS use npm run start:saas via runserver Django.
TELEGRAM_BOT_TOKEN=

# API Django (preenchido automaticamente pelo manage.py runserver)
# ALERT_BRIDGE_API_URL=http://127.0.0.1:8000/api/internal/alert-bridge/configs/
# ALERT_BRIDGE_API_TOKEN=mesmo-token-do-.env-raiz

TELEGRAM_GROUP_ID=

# Login WhatsApp: qr (padrão) ou pairing (código no terminal - ideal VPS)
WHATSAPP_LOGIN_MODE=pairing
# Número da conta que conecta (chip do alerta), só dígitos com DDI 55
WHATSAPP_PAIRING_PHONE=5521999999999

WHATSAPP_ALERT_PHONES=5521999999999

WHATSAPP_GROUP_JID=

MESSAGE_PREFIX=[TG]

ALERT_FILTER_ENABLED=true
ALERT_LINKS=LINK.K2,LINK.INOVA.VIA.INOVA
ALERT_EVENT_KEYWORD=Alto uso de largura de banda (>4.5%)

ANTIBAN_ENABLED=true
ANTIBAN_DELAY_MIN_MS=1000
ANTIBAN_DELAY_MAX_MS=6000
ANTIBAN_WARMUP_SEC=60
