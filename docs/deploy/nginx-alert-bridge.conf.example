# Exemplo Nginx — SaaS + bridge interna (ajuste domínios e paths)

upstream django_app {
    server 127.0.0.1:8000;
    keepalive 32;
}

# Rede interna / Docker bridge — IPs dos workers Node
geo $bridge_allowed {
    default 0;
    127.0.0.1 1;
    ::1 1;
    172.28.0.0/16 1;  # exemplo rede Docker
}

server {
    listen 443 ssl http2;
    server_name rmsys.app www.rmsys.app;

    ssl_certificate     /etc/letsencrypt/live/rmsys.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rmsys.app/privkey.pem;

    client_max_body_size 25m;

    location /static/ {
        alias /var/www/saas-viabilidade/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Mídia: não expor publicamente — Django protegido ou auth_request
    location /media/ {
        proxy_pass http://django_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # API interna alert-bridge — somente workers autorizados
    location /api/internal/alert-bridge/ {
        if ($bridge_allowed = 0) {
            return 403;
        }
        proxy_pass http://django_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://django_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
    }
}

# WhatsApp bridge local — NÃO expor na internet
# server { listen 3921; ... }  # apenas 127.0.0.1
